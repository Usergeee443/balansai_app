<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, maximum-scale=1.0, minimum-scale=1.0">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>Balans AI</title>
    
    <!-- Wallet Style CSS -->
    <link rel="stylesheet" href="/static/css/wallet-style.css">
    
    <!-- Telegram WebApp SDK -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    <!-- Custom Transaction Modal Styles - Telegram Bottom Sheet -->
    <style>
        /* Transaction Modal - Full Screen */
        .txn-modal {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            width: 100%;
            height: 100%;
            z-index: 99999;
            display: none;
            background: #1C1C1E;
        }
        
        .txn-modal.active {
            display: block;
        }
        
        .txn-modal-overlay {
            display: none;
        }
        
        .txn-modal-sheet {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            width: 100%;
            height: 100%;
            background: var(--wallet-bg);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        
        /* Header */
        .txn-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px;
            border-bottom: 0.5px solid var(--wallet-border);
        }
        
        .txn-header-title {
            font-size: 17px;
            font-weight: 600;
            color: var(--wallet-text-primary);
        }
        
        .txn-close-btn {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: var(--wallet-bg-tertiary);
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        
        .txn-close-btn:active {
            transform: scale(0.9);
            background: var(--wallet-bg-secondary);
        }
        
        .txn-close-btn svg {
            width: 14px;
            height: 14px;
            stroke: var(--wallet-text-secondary);
            stroke-width: 2.5;
        }
        
        /* Content */
        .txn-content {
            padding: 16px;
            padding-bottom: calc(16px + env(safe-area-inset-bottom));
            overflow-y: auto;
        }
        
        /* Type Switcher - Telegram Style */
        .txn-type-switcher {
            display: flex;
            background: var(--wallet-bg-secondary);
            border-radius: 10px;
            padding: 2px;
            margin-bottom: 20px;
        }
        
        .txn-type-btn {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 10px 16px;
            border: none;
            background: transparent;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            color: var(--wallet-text-secondary);
            cursor: pointer;
            transition: all 0.2s ease;
            font-family: inherit;
        }
        
        .txn-type-btn.active[data-type="expense"] {
            background: #FF453A;
            color: white;
        }
        
        .txn-type-btn.active[data-type="income"] {
            background: #34C759;
            color: white;
        }
        
        .txn-type-btn svg {
            stroke: currentColor;
        }
        
        /* Amount Display */
        .txn-amount-display {
            text-align: center;
            padding: 12px 0 20px;
        }
        
        .txn-amount-value {
            font-size: 48px;
            font-weight: 400;
            color: var(--wallet-text-primary);
            font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', sans-serif;
            letter-spacing: -1px;
        }
        
        .txn-amount-currency {
            font-size: 20px;
            color: var(--wallet-text-secondary);
            margin-left: 4px;
            font-weight: 400;
        }
        
        /* Category Grid - Telegram Style */
        .txn-category-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            margin-bottom: 20px;
        }
        
        .txn-category-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            padding: 12px 8px;
            background: var(--wallet-bg-secondary);
            border: none;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        
        .txn-category-item:active {
            transform: scale(0.95);
            opacity: 0.8;
        }
        
        .txn-category-item.selected {
            background: rgba(10, 132, 255, 0.15);
        }
        
        .txn-category-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--wallet-bg-tertiary);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .txn-category-item.selected .txn-category-icon {
            background: #0A84FF;
        }
        
        .txn-category-icon svg {
            width: 20px;
            height: 20px;
            stroke: var(--wallet-text-secondary);
        }
        
        .txn-category-item.selected .txn-category-icon svg {
            stroke: white;
        }
        
        .txn-category-item span {
            font-size: 11px;
            font-weight: 500;
            color: var(--wallet-text-secondary);
            text-align: center;
            line-height: 1.2;
        }
        
        .txn-category-item.selected span {
            color: #0A84FF;
        }
        
        /* Custom Keyboard - Telegram Style */
        .txn-keyboard {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            margin-bottom: 16px;
        }
        
        .txn-key {
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--wallet-bg-secondary);
            border: none;
            border-radius: 12px;
            font-size: 28px;
            font-weight: 400;
            color: var(--wallet-text-primary);
            cursor: pointer;
            transition: all 0.1s ease;
            font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', sans-serif;
            height: 56px;
        }
        
        .txn-key:active {
            background: var(--wallet-bg-tertiary);
            transform: scale(0.95);
        }
        
        .txn-key-backspace {
            background: var(--wallet-bg-secondary);
        }
        
        .txn-key-backspace svg {
            width: 26px;
            height: 26px;
            stroke: var(--wallet-text-secondary);
        }
        
        /* Submit Button - Telegram Style */
        .txn-submit-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            padding: 16px;
            background: #0A84FF;
            border: none;
            border-radius: 12px;
            font-size: 17px;
            font-weight: 600;
            color: white;
            cursor: pointer;
            transition: all 0.15s ease;
            font-family: inherit;
        }
        
        .txn-submit-btn:active {
            transform: scale(0.98);
            opacity: 0.9;
        }
        
        .txn-submit-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        
        .txn-submit-btn svg {
            width: 20px;
            height: 20px;
            stroke: white;
        }
    </style>

    <!-- QR Code Scanner -->
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
</head>
<body>
    <!-- ============================================
         HOME PAGE - WALLET STYLE
         ============================================ -->
    <div id="pageHome" class="page active">
        <!-- Header -->
        <div class="wallet-header">
            <div class="wallet-header-left">
                <div class="wallet-avatar" id="userAvatar">B</div>
                <span class="wallet-title">Balans AI <span style="font-size: 12px; opacity: 0.7;">v1.6.0</span></span>
            </div>
            <div class="wallet-header-right">
                <div class="wallet-header-icon" id="themeToggleBtn" onclick="toggleTheme()" title="Rejimni o'zgartirish">
                    <svg id="themeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <!-- Moon icon (dark mode) -->
                        <path id="moonIcon" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                        <!-- Sun icon (light mode) - hidden by default -->
                        <g id="sunIcon" style="display: none;">
                            <circle cx="12" cy="12" r="5"/>
                            <line x1="12" y1="1" x2="12" y2="3"/>
                            <line x1="12" y1="21" x2="12" y2="23"/>
                            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
                            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                            <line x1="1" y1="12" x2="3" y2="12"/>
                            <line x1="21" y1="12" x2="23" y2="12"/>
                            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
                            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                        </g>
                    </svg>
                </div>
                <div class="wallet-header-icon" onclick="showNotifications()">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                    </svg>
                </div>
                <div class="wallet-header-icon" onclick="navigateTo('profile')">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="3"/>
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
            </svg>
        </div>
            </div>
        </div>

        <!-- Balance Section - Telegram Wallet Style with Large Arc Gauge -->
        <div class="tg-balance-section">
            <!-- Large Arc Gauge - Like Telegram Wallet -->
            <div class="tg-balance-gauge">
                <svg class="tg-gauge-svg" viewBox="0 0 300 180">
                    <defs>
                        <linearGradient id="gaugeGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                            <stop offset="0%" style="stop-color:#0A84FF"/>
                            <stop offset="50%" style="stop-color:#5AC8FA"/>
                            <stop offset="100%" style="stop-color:#0A84FF"/>
                        </linearGradient>
                        <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
                            <feGaussianBlur stdDeviation="4" result="coloredBlur"/>
                            <feMerge>
                                <feMergeNode in="coloredBlur"/>
                                <feMergeNode in="SourceGraphic"/>
                            </feMerge>
                        </filter>
                    </defs>
                    <!-- Background arc (gray) - semicircle -->
                    <path class="tg-gauge-bg" d="M 25 155 A 125 125 0 0 1 275 155" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="20" stroke-linecap="round"/>
                    <!-- Progress arc (blue gradient) - semicircle -->
                    <path class="tg-gauge-fill" id="balanceGaugeFill" d="M 25 155 A 125 125 0 0 1 275 155" fill="none" stroke="url(#gaugeGradient)" stroke-width="20" stroke-linecap="round" stroke-dasharray="393" stroke-dashoffset="196.5" filter="url(#glow)"/>
            </svg>

                <!-- Balance Info Inside Gauge -->
                <div class="tg-balance-info">
                    <div class="tg-balance-label" id="balanceLabel">Balans</div>
                    <div class="tg-balance-amount" id="totalBalance">0 so'm</div>
                </div>
        </div>

            <!-- CTA Button -->
            <button class="tg-balance-cta" onclick="showAddTransactionModal()">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M12 5v14M5 12h14"/>
                </svg>
                Tranzaksiya qo'shish
            </button>
        </div>

        <!-- Action Buttons -->
        <div class="wallet-actions">
            <div class="wallet-action-item" onclick="showAddTransactionModal('income')">
                <div class="wallet-action-icon green">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 19V5M5 12l7-7 7 7"/>
                </svg>
            </div>
                <span class="wallet-action-label">Kirim</span>
            </div>
            <div class="wallet-action-item" onclick="showAddTransactionModal('expense')">
                <div class="wallet-action-icon" style="background: rgba(255, 69, 58, 0.15);">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="stroke: #FF453A;">
                        <path d="M12 5v14M5 12l7 7 7-7"/>
                    </svg>
                </div>
                <span class="wallet-action-label">Chiqim</span>
            </div>
            <div class="wallet-action-item" onclick="navigateTo('debts')">
                <div class="wallet-action-icon orange">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 11h4a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2h4"/>
                        <rect x="8" y="5" width="8" height="12" rx="1"/>
                    </svg>
                </div>
                <span class="wallet-action-label">Qarzlar</span>
            </div>
            <div class="wallet-action-item" onclick="navigateTo('statistics')">
                <div class="wallet-action-icon purple">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 20V10M12 20V4M6 20v-6"/>
                    </svg>
                </div>
                <span class="wallet-action-label">Statistika</span>
            </div>
        </div>

        <!-- Business Quick Actions (Only for BUSINESS tariff) -->
        <div id="businessQuickActions" class="wallet-section" style="display: none;">
            <div class="wallet-section-header">
                <h2 class="wallet-section-title">💼 Biznes boshqaruvi</h2>
            </div>
            <div class="wallet-actions" style="grid-template-columns: repeat(3, 1fr);">
                <div class="wallet-action-item" onclick="window.location.href='/business?page=warehouse'">
                    <div class="wallet-action-icon purple">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                </svg>
            </div>
                    <span class="wallet-action-label">Ombor</span>
            </div>
                <div class="wallet-action-item" onclick="window.location.href='/business?page=employees'">
                    <div class="wallet-action-icon green">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                    </div>
                    <span class="wallet-action-label">Xodimlar</span>
                </div>
                <div class="wallet-action-item" onclick="window.location.href='/business?page=tasks'">
                    <div class="wallet-action-icon blue">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M9 11l3 3L22 4"/>
                            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
                        </svg>
                    </div>
                    <span class="wallet-action-label">Vazifalar</span>
                </div>
    </div>

            <!-- Business Statistics Preview -->
            <div class="wallet-stats-overview" style="margin-top: 12px;">
                <div class="wallet-stat-card">
                    <div class="wallet-stat-value" id="businessStatProducts">0</div>
                    <div class="wallet-stat-label">Mahsulotlar</div>
                </div>
                <div class="wallet-stat-card">
                    <div class="wallet-stat-value" id="businessStatEmployees">0</div>
                    <div class="wallet-stat-label">Xodimlar</div>
                </div>
                <div class="wallet-stat-card">
                    <div class="wallet-stat-value" id="businessStatTasks">0</div>
                    <div class="wallet-stat-label">Vazifalar</div>
                </div>
            </div>

            <!-- AI Recommendations -->
            <div id="aiRecommendations" class="wallet-chart-card" style="margin-top: 16px; display: none;">
                <div class="wallet-chart-header">
                    <span class="wallet-chart-title">🤖 AI tavsiyalari</span>
                </div>
                <div id="aiRecommendationsList" style="padding: 12px 0;">
                    <!-- Loaded via JavaScript -->
                </div>
            </div>
        </div>

        <!-- Tez kirish xizmatlari (User tanlagan) -->
        <div class="wallet-section" style="margin-top: 8px;">
            <div class="wallet-section-header">
                <h2 class="wallet-section-title">Tez kirish</h2>
                <button class="wallet-section-action" onclick="showQuickAccessSettings()">
